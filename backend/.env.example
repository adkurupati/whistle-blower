# Copy to .env for local dev. Matches docker-compose.yml credentials.
DATABASE_URL=postgresql+psycopg2://nba_officiating:devpassword@localhost:5432/nba_officiating

# HS256 JWT signing secret. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production

# Bluesky credentials for scripts/check_bluesky_volume.py (Fan Discussion Sourcing
# spot-check — Phase 6 source selection). Create an app password at
# bsky.app -> Settings -> App Passwords; do NOT use your account password.
BSKY_IDENTIFIER=yourhandle.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# YouTube Data API v3 key for scripts/check_youtube_volume.py (Fan Discussion
# Sourcing spot-check — Phase 6 source selection). Create at
# console.cloud.google.com -> APIs & Services -> Credentials, after enabling
# "YouTube Data API v3". 10,000 quota units/day free.
YOUTUBE_API_KEY=AIzaSy-your-api-key-here

# Ollama for Phase 7 AI Verdict synthesis. Install via `brew install ollama`
# and start with `ollama serve` (or let the macOS app do it). The default
# model is qwen2.5:3b-instruct-q4_K_M (chosen for 8 GB M2 — ~2.5 GB resident,
# strong JSON-mode compliance); override OLLAMA_MODEL if you've pulled a
# different one. Pull with `ollama pull qwen2.5:3b-instruct-q4_K_M`.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
